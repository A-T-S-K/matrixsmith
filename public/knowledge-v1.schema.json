{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "redistribution",
    "aliases",
    "families",
    "sheets",
    "records",
    "assertions",
    "sources",
    "conflicts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "redistribution": {
      "type": "string",
      "maxLength": 2048
    },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "families": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "sheetId",
          "resolution",
          "unknowns",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          },
          "sheetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution": {
            "enum": ["documented-line", "unresolved"]
          },
          "unknowns": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "match": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "serviceUuid",
                  "characteristicUuids",
                  "assertionId"
                ],
                "properties": {
                  "serviceUuid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f-]{36}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "characteristicUuids": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f-]{36}$"
                    }
                  },
                  "assertionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "sheets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "familyId", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "familyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "scope",
          "families",
          "aliases",
          "notes",
          "unknowns",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          },
          "scope": {
            "type": "string",
            "maxLength": 2048
          },
          "families": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 2048
          },
          "unknowns": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "references": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "locator"],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "locator": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "familyId",
          "field",
          "text",
          "basis",
          "scope",
          "evidence",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "familyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "field": {
            "type": "string",
            "maxLength": 2048
          },
          "text": {
            "type": "string",
            "maxLength": 2048
          },
          "basis": {
            "enum": [
              "specified",
              "implemented",
              "author-observed",
              "corroborated",
              "hypothesis",
              "unknown"
            ]
          },
          "scope": {
            "type": "string",
            "maxLength": 2048
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "locator"],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "locator": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "revision",
          "sha256",
          "origin",
          "license",
          "attribution",
          "retrieved",
          "status",
          "derivedFrom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https[:]//[^\\s]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "license": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "attribution": {
            "type": "string",
            "maxLength": 2048
          },
          "retrieved": {
            "enum": ["2026-10-02", "2026-10-03"]
          },
          "status": {
            "type": "string",
            "maxLength": 2048
          },
          "derivedFrom": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sources"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "text": {
            "type": "string",
            "maxLength": 2048
          },
          "sources": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    }
  }
}
